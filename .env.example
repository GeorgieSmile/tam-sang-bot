# Local SQLite database and menu config
DB_PATH=shop.db
MENU_PATH=menu.yaml

# Kitchen board access secret (open /kitchen?key=<KITCHEN_SECRET>)
KITCHEN_SECRET=change-me-kitchen-secret
PUBLIC_BASE_URL=http://localhost:8000

# Optional payment text shown in confirmation replies (leave blank to omit)
PAYMENT_INFO_TEXT=

# PromptPay QR with the exact amount on receipts (10-digit phone or 13-digit ID).
# Blank = no QR; PAYMENT_INFO_TEXT is shown instead.
PROMPTPAY_ID=

# SlipOK slip verification (blank = slips go to the owner's inbox unchecked).
# Register the same bank account as PROMPTPAY_ID in SlipOK's LINE setup.
SLIPOK_API_KEY=
SLIPOK_BRANCH_ID=

# LINE Messaging API (from LINE Developers Console)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
OWNER_LINE_USER_ID=

# OpenAI-compatible LLM endpoint (defaults to OpenRouter)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=anthropic/claude-haiku-5.5
LLM_REASONING_EFFORT=low
